{
  "schema_version": "mood-social-forecast-v3.4-opt-search-v1",
  "selection_metric": "participant_equal_auprc",
  "tie_breaker": "participant_equal_brier_then_candidate_order",
  "candidate_policy": "two frozen base settings per family; auxiliary variants use setting index 0",
