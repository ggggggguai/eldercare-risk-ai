      "n_estimators": 120,
      "learning_rate": 0.03,
      "num_leaves": 15,
      "max_depth": 5,
      "min_child_samples": 50,
      "subsample": 0.8,
      "subsample_freq": 1,
      "colsample_bytree": 0.8,
      "reg_alpha": 0.1,
      "reg_lambda": 1.0
    },
    {
      "n_estimators": 220,
      "learning_rate": 0.03,
      "num_leaves": 7,
      "max_depth": 3,
      "min_child_samples": 20,
      "subsample": 1.0,
      "subsample_freq": 1,
      "colsample_bytree": 1.0,
      "reg_alpha": 0.0,
      "reg_lambda": 0.1
    }
  ],
  "catboost": [
    {
      "iterations": 150,
      "depth": 4,
      "learning_rate": 0.03,
      "l2_leaf_reg": 5.0,
      "random_strength": 0.5
    },
    {
      "iterations": 250,
      "depth": 6,
      "learning_rate": 0.03,
      "l2_leaf_reg": 3.0,
      "random_strength": 1.0
    }
  ]
}
