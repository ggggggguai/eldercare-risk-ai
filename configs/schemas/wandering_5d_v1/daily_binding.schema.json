{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wandering-camera-real-development-binding-v1",
  "title": "Explicit real-development camera person/session/time/presence binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "binding_id", "validation_scope", "capture_clock_status",
    "person_identity_source", "development_index", "config_sha256",
    "video_binding_count", "session_count", "person_count", "video_bindings"
  ],
  "properties": {
    "schema_version": {"const": "wandering-camera-real-development-binding-v1"},
    "binding_id": {"type": "string", "minLength": 1},
    "validation_scope": {"const": "b01_b02_development"},
    "capture_clock_status": {"const": "unavailable_declared_development_schedule"},
    "person_identity_source": {"const": "development_index_owner_binding_not_track_id"},
    "development_index": {"$ref": "#/$defs/source_ref"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "video_binding_count": {"type": "integer", "minimum": 1},
    "session_count": {"type": "integer", "minimum": 1},
    "person_count": {"type": "integer", "minimum": 1},
    "video_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/video_binding"}}
  },
  "$defs": {
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["start_sec", "end_sec_exclusive"],
      "properties": {
        "start_sec": {"type": "number", "minimum": 0},
        "end_sec_exclusive": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "source_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["ref_type", "ref_id", "artifact_path", "sha256"],
      "properties": {
        "ref_type": {"type": "string", "minLength": 1},
        "ref_id": {"type": "string", "minLength": 1},
        "artifact_path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "video_binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_video_id", "session_id", "person_id", "timezone", "started_at", "end_at",
        "time_basis", "presence_basis", "presence_intervals_sec", "tracking_intervals_sec", "source_refs"
      ],
      "properties": {
        "source_video_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "person_id": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "end_at": {"type": "string", "format": "date-time"},
        "time_basis": {"type": "string", "minLength": 1},
        "presence_basis": {"type": "string", "minLength": 1},
        "presence_intervals_sec": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interval"}},
        "tracking_intervals_sec": {"type": "array", "items": {"$ref": "#/$defs/interval"}},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_ref"}}
      }
    }
  }
}
