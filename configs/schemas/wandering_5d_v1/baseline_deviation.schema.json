{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wandering-handoff-baseline-deviation-v1",
  "title": "Person-day deviation from prior rolling baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module",
    "record_id",
    "deviation_id",
    "profile_id",
    "person_id",
    "session_id",
    "source_video_id",
    "local_date",
    "timezone",
    "status",
    "readiness_status",
    "metrics",
    "quality_flags",
    "identity",
    "source_refs"
  ],
  "properties": {
    "schema_version": {"const": "wandering-handoff-baseline-deviation-v1"},
    "module": {"const": "mental_health"},
    "record_id": {"type": "string", "minLength": 1},
    "deviation_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": ["string", "null"]},
    "person_id": {"type": "string", "minLength": 1},
    "session_id": {"type": ["string", "null"]},
    "source_video_id": {"type": ["string", "null"]},
    "local_date": {"type": "string", "format": "date"},
    "timezone": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "uncertain", "unavailable", "error"]},
    "readiness_status": {"enum": ["warming_up", "initial_ready", "stable_ready", "unavailable"]},
    "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/deviation_metric"}},
    "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "identity": {"$ref": "#/$defs/identity"},
    "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_ref"}}
  },
  "$defs": {
    "deviation_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observation_value", "reference_count", "reference_median", "reference_p90", "delta_from_median", "delta_from_p90"],
      "properties": {
        "status": {"enum": ["ready", "warming_up", "observation_unavailable", "reference_unavailable"]},
        "observation_value": {"type": ["number", "null"]},
        "reference_count": {"type": "integer", "minimum": 0},
        "reference_median": {"type": ["number", "null"]},
        "reference_p90": {"type": ["number", "null"]},
        "delta_from_median": {"type": ["number", "null"]},
        "delta_from_p90": {"type": ["number", "null"]}
      }
    },
    "identity": {
      "type": "object",
      "required": ["model_id", "model_sha256", "config_id", "config_sha256", "policy_id", "policy_sha256"],
      "properties": {
        "model_id": {"type": ["string", "null"]},
        "model_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "config_id": {"type": "string", "minLength": 1},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy_id": {"type": "string", "minLength": 1},
        "policy_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_ref": {
      "type": "object",
      "required": ["ref_type", "ref_id", "artifact_path", "sha256"],
      "properties": {
        "ref_type": {"type": "string", "minLength": 1},
        "ref_id": {"type": "string", "minLength": 1},
        "artifact_path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
