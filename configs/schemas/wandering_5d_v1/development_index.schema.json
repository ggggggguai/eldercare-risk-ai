{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wandering-camera-development-index-v1",
  "title": "B01+B02 camera development index row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_role",
    "development_reuse_allowed",
    "batch_id",
    "historical_role",
    "participant_id",
    "session_id",
    "camera_setup_id",
    "sidecar_setup_id",
    "setup_binding_status",
    "clock_domain_id",
    "source_video_id",
    "source_group_id",
    "device_id",
    "stream_epoch",
    "timezone",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "wandering-camera-development-index-v1"},
    "dataset_role": {"const": "development"},
    "development_reuse_allowed": {"const": true},
    "batch_id": {"enum": ["B01", "B02"]},
    "historical_role": {"type": "string", "minLength": 1},
    "participant_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "camera_setup_id": {"type": "string", "minLength": 1},
    "sidecar_setup_id": {"type": "string", "minLength": 1},
    "setup_binding_status": {"enum": ["consistent", "owner_confirmed_legacy_alias"]},
    "clock_domain_id": {"type": "string", "minLength": 1},
    "source_video_id": {"type": "string", "minLength": 1},
    "source_group_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "stream_epoch": {"type": "string", "minLength": 1},
    "timezone": {"type": ["string", "null"]},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video", "tracking", "media_sidecar", "truth", "cvat_xml"],
      "properties": {
        "video": {"$ref": "#/$defs/locator"},
        "tracking": {"$ref": "#/$defs/locator"},
        "media_sidecar": {"$ref": "#/$defs/locator"},
        "truth": {"$ref": "#/$defs/locator"},
        "cvat_xml": {"$ref": "#/$defs/locator"}
      }
    }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_kind", "path", "byte_count", "sha256"],
      "properties": {
        "path_kind": {"enum": ["external_read_only", "workspace_generated"]},
        "path": {"type": "string", "minLength": 1},
        "byte_count": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
