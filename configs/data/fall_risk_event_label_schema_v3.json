{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elderly-monitoring.local/schemas/fall-risk-event-label-v3.json",
  "title": "Fall-risk training event label v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "label_id",
    "asset_id",
    "video_id",
    "content_sha256",
    "subject_id",
    "source_group_id",
    "sample_group_id",
    "track_id",
    "start_frame",
    "end_frame_exclusive",
    "frame_index_base",
    "start_time",
    "end_time_exclusive",
    "target_status",
    "boundary_precision",
    "quality_flags",
    "training_tier",
    "source_refs",
    "annotator_id",
    "reviewer_ids",
    "review_status",
    "note",
    "physical_event_id",
    "task_type",
    "label_role",
    "event_type",
    "event_subtype",
    "event_outcome",
    "hard_negative_type",
    "onset_frame",
    "peak_frame",
    "impact_frame",
    "recovery_frame",
    "linked_action_ids",
    "contact_evidence",
    "subtype_training_tier"
  ],
  "properties": {
    "schema_version": {"const": "fall-risk-event-label-v3"},
    "label_id": {"type": "string", "pattern": "^eventv3_[0-9a-f]{24}$"},
    "asset_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject_id": {"type": "string", "minLength": 1},
    "source_group_id": {"type": "string", "minLength": 1},
    "sample_group_id": {"type": "string", "pattern": "^samplegrp_[0-9a-f]{24}$"},
    "track_id": {"type": ["string", "null"]},
    "start_frame": {"type": "integer", "minimum": 0},
    "end_frame_exclusive": {"type": "integer", "minimum": 1},
    "frame_index_base": {"const": 0},
    "start_time": {"type": "number", "minimum": 0},
    "end_time_exclusive": {"type": "number", "exclusiveMinimum": 0},
    "target_status": {
      "enum": ["confirmed", "single_person_assumed", "uncertain"]
    },
    "boundary_precision": {"enum": ["exact", "approximate", "unknown"]},
    "quality_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "partial_occlusion", "heavy_occlusion", "low_light", "motion_blur",
          "low_resolution", "off_screen", "multi_person_uncertain", "camera_cut"
        ]
      }
    },
    "training_tier": {"enum": ["primary", "auxiliary", "ignore"]},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_type", "source_record_id", "source_annotation_path",
          "source_annotation_sha256", "source_label_id"
        ],
        "properties": {
          "source_type": {
            "enum": ["v2_cvat_action", "v2_cvat_action_mapping", "v2_le2i_txt", "v2_toaga_official_walking", "v2_ntu_rgbd_clip_label", "v2_ntu_rgbd_manual_clip_label", "manual_v3"]
          },
          "source_record_id": {"type": "string", "minLength": 1},
          "source_annotation_path": {"type": "string", "minLength": 1},
          "source_annotation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_label_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "annotator_id": {"type": "string", "minLength": 1},
    "reviewer_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "review_status": {
      "enum": [
        "unreviewed", "single_annotated", "source_verified", "single_reviewed",
        "double_reviewed", "adjudicated"
      ]
    },
    "note": {"type": "string"},
    "physical_event_id": {
      "type": ["string", "null"],
      "pattern": "^physical_[0-9a-f]{24}$"
    },
    "task_type": {"enum": ["fall_event", "near_fall_event"]},
    "label_role": {"enum": ["positive", "negative", "ignore"]},
    "event_type": {"type": ["string", "null"], "enum": ["fall", "near_fall", null]},
    "event_subtype": {
      "type": ["string", "null"],
      "enum": [
        "forward", "lateral", "backward", "seated", "unknown", "stumble_recovery",
        "rapid_support_recovery", "rapid_body_drop_recovery", "sudden_stop_recovery",
        "other_recovery", null
      ]
    },
    "event_outcome": {
      "type": ["string", "null"],
      "enum": ["fell", "recovered_without_fall", null]
    },
    "hard_negative_type": {
      "type": ["string", "null"],
      "enum": [
        "background", "controlled_sit_down", "controlled_lie_down", "squat_or_kneel",
        "bend", "bed_entry_or_exit", "assisted_lowering", "occlusion_or_camera_motion",
        "normal_turn", "normal_step_adjustment", "routine_support_contact",
        "fast_but_controlled_sit", "controlled_squat", "controlled_bend",
        "exercise_or_stretch", "progressed_to_fall", null
      ]
    },
    "onset_frame": {"type": ["integer", "null"], "minimum": 0},
    "peak_frame": {"type": ["integer", "null"], "minimum": 0},
    "impact_frame": {"type": ["integer", "null"], "minimum": 0},
    "recovery_frame": {"type": ["integer", "null"], "minimum": 0},
    "linked_action_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^actionv3_[0-9a-f]{24}$"}
    },
    "contact_evidence": {"enum": ["observed", "proxy", "unknown", "not_applicable"]},
    "subtype_training_tier": {"enum": ["primary", "auxiliary", "ignore"]}
  }
}
