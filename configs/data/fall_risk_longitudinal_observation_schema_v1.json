{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fall-risk-longitudinal-observation-v1",
  "title": "Fall Risk Longitudinal Observation",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "observation_id",
    "record_type",
    "schema_version",
    "asset_id",
    "person_id",
    "device_id",
    "camera_profile_id",
    "source_group_id",
    "period_id",
    "period_start",
    "period_end",
    "timezone",
    "completed",
    "aggregation_version",
    "upstream_versions",
    "input_summary",
    "valid_monitoring_hours",
    "metric_quality",
    "quality_state",
    "no_personal_baseline_score",
    "no_personal_baseline_available_weight",
    "fusion_config_version",
    "outcome_label_id"
  ],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "record_type": {"const": "fall_baseline_period_features"},
    "schema_version": {"const": "fall-baseline-period-features-v1"},
    "asset_id": {"type": "string", "minLength": 1},
    "person_id": {"type": "string", "minLength": 1, "not": {"const": "unknown"}},
    "device_id": {"type": "string", "minLength": 1},
    "camera_profile_id": {"type": "string", "minLength": 1},
    "source_group_id": {"type": "string", "minLength": 1},
    "period_id": {"type": "string", "minLength": 1},
    "period_start": {"type": "string", "format": "date-time"},
    "period_end": {"type": "string", "format": "date-time"},
    "timezone": {"type": "string", "minLength": 1},
    "completed": {"const": true},
    "aggregation_version": {"type": "string", "minLength": 1},
    "upstream_versions": {"type": "object", "minProperties": 1},
    "input_summary": {"type": "object", "minProperties": 1},
    "valid_monitoring_hours": {"type": "number", "exclusiveMinimum": 0},
    "metric_quality": {"type": "object", "minProperties": 1},
    "quality_state": {"enum": ["valid", "reduced", "unavailable"]},
    "no_personal_baseline_score": {"type": "number", "minimum": 0, "maximum": 1},
    "no_personal_baseline_available_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.84},
    "fusion_config_version": {"type": "string", "minLength": 1},
    "outcome_label_id": {"type": ["string", "null"]}
  }
}
